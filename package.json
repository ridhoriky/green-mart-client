{
  "name": "greenmart-marketplace",
  "author": "Ridho",
  "type": "module",
  "scripts": {
    "dev:spotlight": "npx @spotlightjs/spotlight",
    "dev:next": "next dev",
    "dev": "run-p dev:*",
    "build:next": "next build",
    "build-local": "npm run build:next",
    "build": "npm run build:next",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "clean": "rimraf .next out coverage",
    "lint": "ultracite check --type-aware --type-check",
    "lint:fix": "ultracite fix --type-aware --type-check",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl -i \"Index.CategoryMenu.*\" -i \"ProductsPage.*\" -i \"DealsPage.*\" -i \"FlashSalePage.*\" -i \"CartPage.*\" -i \"SellerRegisterPage.*\" -i \"SellerDashboard.*\" -i \"WishlistPage.*\" -i \"StorePage.*\" -i \"OrderDetailPage.*\" -i \"PaymentPage.*\"",
    "commit": "commit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "vitest run --config .storybook/vitest.config.ts",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@arcjet/next": "^1.13.0",
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@react-oauth/google": "^0.13.5",
    "@sentry/nextjs": "^10.75.3",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.104.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "material-symbols": "^0.47.5",
    "next": "^16.3.6",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@chromatic-com/playwright": "^0.15.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.0.1",
    "@commitlint/prompt-cli": "^21.2.3",
    "@commitlint/types": "^21.0.1",
    "@faker-js/faker": "^10.6.0",
    "@lingual/i18n-check": "^0.9.5",
    "@next/bundle-analyzer": "^16.3.6",
    "@playwright/test": "^1.63.0",
    "@spotlightjs/spotlight": "^4.11.8",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@swc/helpers": "^0.5.21",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "babel-plugin-react-compiler": "^1.0.0",
    "checkly": "^7.14.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^0.25.0",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "storybook": "^10.4.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "ultracite": "^7.12.1",
    "vitest": "^4.1.7"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
